{
  "hooks": {
    "BeforeTool": [
      {
        "matcher": "mcp_swiftfairy_.*audit.*",
        "hooks": [
          {
            "name": "swiftfairy-private-source-transfer",
            "type": "command",
            "command": "/usr/bin/osascript -l JavaScript \"${extensionPath}/hooks/hydrate-swiftfairy-source.js\"",
            "timeout": 30000,
            "description": "Transfers Swift source to SwiftFairy without placing it in model context."
          }
        ]
      }
    ]
  }
}
