#!/usr/bin/env python3
"""
swiftfairy-standin: A CLI utility that acts as a standalone integration installer
and manager for SwiftFairy across modern AI coding agents.
"""

import os
import sys
import json
import shutil
import subprocess
import argparse
from pathlib import Path

# Paths & Defaults
DEFAULT_HELPER_CANDIDATES = [
    "/Applications/SwiftFairy.app/Contents/Helpers/swiftfairy-stdio",
    os.path.expanduser("~/Workspace/Sandbox/swiftfairy/SwiftFairy/Contents/Helpers/swiftfairy-stdio"),
]

SCRIPT_DIR = Path(__file__).resolve().parent
BUNDLES_DIR = SCRIPT_DIR / "bundles"
HOME = Path.home()

def find_stdio_helper(custom_path=None):
    if custom_path and os.path.exists(custom_path):
        return os.path.abspath(custom_path)
    env_path = os.environ.get("SWIFTFAIRY_STDIO_PATH")
    if env_path and os.path.exists(env_path):
        return os.path.abspath(env_path)
    for candidate in DEFAULT_HELPER_CANDIDATES:
        if os.path.exists(candidate):
            return candidate
    return None

def copy_tree_with_substitution(src: Path, dst: Path, placeholder_or_dict, replacement=None):
    replacements = placeholder_or_dict if isinstance(placeholder_or_dict, dict) else {placeholder_or_dict: replacement}
    if dst.exists():
        shutil.rmtree(dst)
    dst.mkdir(parents=True, exist_ok=True)
    
    for root, dirs, files in os.walk(src):
        rel_root = Path(root).relative_to(src)
        target_dir = dst / rel_root
        target_dir.mkdir(parents=True, exist_ok=True)
        
        for file in files:
            src_file = Path(root) / file
            dst_file = target_dir / file
            
            # Text substitution for JSON / config files
            if file.endswith((".json", ".jsonc", ".md", ".js")):
                try:
                    content = src_file.read_text(encoding="utf-8")
                    for k, v in replacements.items():
                        content = content.replace(k, v)
                    dst_file.write_text(content, encoding="utf-8")
                except UnicodeDecodeError:
                    shutil.copy2(src_file, dst_file)
            else:
                shutil.copy2(src_file, dst_file)

