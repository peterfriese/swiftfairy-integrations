class GeminiCLIHandler:
    name = "gemini"
    display_name = "Gemini CLI"
    target_dir = HOME / ".gemini" / "extensions" / "swiftfairy"
    trusted_folders_file = HOME / ".gemini" / "trustedFolders.json"

    @classmethod
    def is_detected(cls):
        return (HOME / ".gemini").exists() or shutil.which("gemini") is not None

    @classmethod
    def is_installed(cls):
        return (cls.target_dir / "gemini-extension.json").exists()

    @classmethod
    def install(cls, helper_path):
        src_bundle = BUNDLES_DIR / "GeminiCLI"
        if not src_bundle.exists():
            raise FileNotFoundError(f"Missing bundle: {src_bundle}")
        
        # 1. Install extension files directly to ~/.gemini/extensions/swiftfairy
        copy_tree_with_substitution(
            src_bundle,
            cls.target_dir,
            {
                "__SWIFTFAIRY_STDIO_HELPER__": helper_path,
                "__EXTENSION_DIR__": str(cls.target_dir)
            }
        )
        print(f"  ✅ Installed Gemini CLI extension directly to: {cls.target_dir}")

        # 2. Pre-authorize in trustedFolders.json to prevent folder-auth / TTY hang
        try:
            trusted = {}
            if cls.trusted_folders_file.exists():
                try:
                    trusted = json.loads(cls.trusted_folders_file.read_text(encoding="utf-8"))
                except Exception:
                    trusted = {}
            
            # Paths in trustedFolders.json are stored lowercase in gemini-cli
            trusted[str(cls.target_dir).lower()] = "TRUST_FOLDER"
            cls.trusted_folders_file.parent.mkdir(parents=True, exist_ok=True)
            cls.trusted_folders_file.write_text(json.dumps(trusted, indent=2) + "\n", encoding="utf-8")
            print(f"  🔒 Pre-authorized folder trust in: {cls.trusted_folders_file}")
        except Exception as e:
            print(f"  ⚠️  Could not update trustedFolders.json: {e}")

    @classmethod
    def uninstall(cls):
        if cls.target_dir.exists():
            shutil.rmtree(cls.target_dir)
            print(f"  🗑️  Removed: {cls.target_dir}")
        else:
            print("  ℹ️  Not installed.")

ALL_HANDLERS = [
    AntigravityHandler,
    AntigravityIDEHandler,
    OpenCodeHandler,
    XcodeHandler,
    CursorHandler,
    VSCodeHandler,
    GeminiCLIHandler,
]

# -----------------------------------------------------------------------------
# CLI Commands
# -----------------------------------------------------------------------------

def cmd_list(args, helper_path):
    print("\n🔍 SwiftFairy Standin: Agent Integrations Status\n" + "="*50)
    for h in ALL_HANDLERS:
        detected = h.is_detected()
        installed = h.is_installed()
        
        if installed:
            status = "🟢 Configured"
        elif detected:
            status = "🟡 Detected (Ready to Install)"
        else:
            status = "⚪ Not Found"
            
        print(f"  {h.display_name:<36} : {status}")
    print("="*50)
    if helper_path:
        print(f"  Helper: {helper_path}\n")
    else:
        print("  ⚠️  swiftfairy-stdio helper binary not found. Install SwiftFairy or pass --helper\n")

def cmd_install(args, helper_path):
    if not helper_path:
        print("❌ Cannot install: swiftfairy-stdio helper could not be located.")
        sys.exit(1)
        
    target = args.target.lower()
    targets = ALL_HANDLERS if target == "all" else [h for h in ALL_HANDLERS if h.name == target]
    
    if not targets:
        print(f"❌ Unknown target '{args.target}'. Valid targets: {', '.join([h.name for h in ALL_HANDLERS])}, all")
        sys.exit(1)
        
    for h in targets:
        print(f"Installing integration for {h.display_name}...")
        try:
            h.install(helper_path)
        except Exception as e:
            print(f"  ❌ Error: {e}")

def cmd_uninstall(args, helper_path):
    target = args.target.lower()
    targets = ALL_HANDLERS if target == "all" else [h for h in ALL_HANDLERS if h.name == target]
    
    if not targets:
        print(f"❌ Unknown target '{args.target}'. Valid targets: {', '.join([h.name for h in ALL_HANDLERS])}, all")
        sys.exit(1)
        
    for h in targets:
        print(f"Uninstalling integration for {h.display_name}...")
        try:
            h.uninstall()
        except Exception as e:
            print(f"  ❌ Error: {e}")

def cmd_test(args, helper_path):
    if not helper_path:
        print("❌ Helper binary not found.")
        sys.exit(1)
    print(f"Testing stdio helper: {helper_path}")
    if os.path.exists(helper_path) and os.access(helper_path, os.X_OK):
        print("  ✅ Binary exists and is executable.")
    else:
        print("  ❌ Binary is missing or not executable.")

def main():
    parser = argparse.ArgumentParser(description="SwiftFairy Standin Integration Tool")
    parser.add_argument("--helper", help="Custom path to swiftfairy-stdio binary", default=None)
    subparsers = parser.add_subparsers(dest="command", required=True)
    
    # list
    p_list = subparsers.add_parser("list", help="List status of all coding agents")
    p_list.set_defaults(func=cmd_list)
    
    # install
    p_install = subparsers.add_parser("install", help="Install SwiftFairy into an agent")
    p_install.add_argument("target", help="Agent identifier (antigravity, antigravity-ide, opencode, xcode, cursor, vscode, gemini, all)")
    p_install.set_defaults(func=cmd_install)
    
    # uninstall
    p_uninstall = subparsers.add_parser("uninstall", help="Uninstall SwiftFairy from an agent")
    p_uninstall.add_argument("target", help="Agent identifier (antigravity, antigravity-ide, opencode, xcode, cursor, vscode, gemini, all)")
    p_uninstall.set_defaults(func=cmd_uninstall)
    
    # test
    p_test = subparsers.add_parser("test", help="Test stdio helper binary availability")
    p_test.set_defaults(func=cmd_test)
    
    args = parser.parse_args()
    helper = find_stdio_helper(args.helper)
    args.func(args, helper)

if __name__ == "__main__":
    main()
