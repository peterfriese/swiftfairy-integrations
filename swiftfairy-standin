class AntigravityHandler:
    name = "antigravity"
    display_name = "Google Antigravity (Agent Manager / CLI)"
    target_dir = HOME / ".gemini" / "antigravity" / "plugins" / "swiftfairy"
    
    @classmethod
    def is_detected(cls):
        return (HOME / ".gemini" / "antigravity").exists() or \
               shutil.which("agy") is not None
               
    @classmethod
    def is_installed(cls):
        return (cls.target_dir / "plugin.json").exists() and \
               (cls.target_dir / "mcp_config.json").exists()
               
    @classmethod
    def install(cls, helper_path):
        src_bundle = BUNDLES_DIR / "AntigravityPlugin"
        if not src_bundle.exists():
            raise FileNotFoundError(f"Missing bundle: {src_bundle}")
        copy_tree_with_substitution(src_bundle, cls.target_dir, "__SWIFTFAIRY_STDIO_HELPER__", helper_path)
        print(f"  ✅ Installed Antigravity plugin to: {cls.target_dir}")

    @classmethod
    def uninstall(cls):
        if cls.target_dir.exists():
            shutil.rmtree(cls.target_dir)
            print(f"  🗑️  Removed: {cls.target_dir}")
        else:
            print("  ℹ️  Not installed.")

class AntigravityIDEHandler:
    name = "antigravity-ide"
    display_name = "Antigravity IDE"
    config_file = HOME / "Library" / "Application Support" / "Antigravity IDE" / "User" / "mcp.json"
    
    @classmethod
    def is_detected(cls):
        app_support = HOME / "Library" / "Application Support" / "Antigravity IDE"
        return app_support.exists() or Path("/Applications/Antigravity IDE.app").exists()
        
    @classmethod
    def is_installed(cls):
        if not cls.config_file.exists():
            return False
        try:
            data = json.loads(cls.config_file.read_text(encoding="utf-8"))
            return "swiftfairy" in data.get("mcpServers", {})
        except Exception:
            return False
            
    @classmethod
    def install(cls, helper_path):
        cls.config_file.parent.mkdir(parents=True, exist_ok=True)
        data = {}
        if cls.config_file.exists():
            try:
                data = json.loads(cls.config_file.read_text(encoding="utf-8"))
            except Exception:
                data = {}
        servers = data.setdefault("mcpServers", {})
        servers["swiftfairy"] = {
            "command": helper_path,
            "args": []
        }
        cls.config_file.write_text(json.dumps(data, indent=2) + "\n", encoding="utf-8")
        print(f"  ✅ Configured MCP server in: {cls.config_file}")

    @classmethod
    def uninstall(cls):
        if not cls.config_file.exists():
            print("  ℹ️  Config file does not exist.")
            return
        try:
            data = json.loads(cls.config_file.read_text(encoding="utf-8"))
            if "swiftfairy" in data.get("mcpServers", {}):
                del data["mcpServers"]["swiftfairy"]
                cls.config_file.write_text(json.dumps(data, indent=2) + "\n", encoding="utf-8")
                print(f"  🗑️  Removed swiftfairy from: {cls.config_file}")
            else:
                print("  ℹ️  SwiftFairy not found in configuration.")
        except Exception as e:
            print(f"  ❌ Error updating {cls.config_file}: {e}")

class OpenCodeHandler:
    name = "opencode"
    display_name = "OpenCode & OpenChamber"
    config_file = HOME / ".config" / "opencode" / "opencode.jsonc"
    skill_dir = HOME / ".config" / "opencode" / "skills" / "swiftfairy"
    
    @classmethod
    def is_detected(cls):
        return (HOME / ".config" / "opencode").exists() or \
               (HOME / ".config" / "openchamber").exists() or \
               shutil.which("opencode") is not None
               
    @classmethod
    def is_installed(cls):
        has_skill = (cls.skill_dir / "SKILL.md").exists()
        has_mcp = False
        if cls.config_file.exists():
            try:
                # Strip simple single-line comments for JSON parsing
                lines = [l for l in cls.config_file.read_text(encoding="utf-8").splitlines() if not l.strip().startswith("//")]
                data = json.loads("\n".join(lines))
                has_mcp = "swiftfairy" in data.get("mcp", {})
            except Exception:
                has_mcp = False
        return has_skill and has_mcp
        
    @classmethod
    def install(cls, helper_path):
        cls.config_file.parent.mkdir(parents=True, exist_ok=True)
        
        # 1. Update opencode.jsonc
        data = {}
        if cls.config_file.exists():
            try:
                lines = [l for l in cls.config_file.read_text(encoding="utf-8").splitlines() if not l.strip().startswith("//")]
                data = json.loads("\n".join(lines))
            except Exception:
                data = {}
        mcp_section = data.setdefault("mcp", {})
        mcp_section["swiftfairy"] = {
            "type": "local",
            "command": [helper_path],
            "enabled": True
        }
        cls.config_file.write_text(json.dumps(data, indent=2) + "\n", encoding="utf-8")
        print(f"  ✅ Updated OpenCode configuration: {cls.config_file}")
        
        # 2. Copy Skill
        cls.skill_dir.mkdir(parents=True, exist_ok=True)
        src_skill = BUNDLES_DIR / "OpenCode" / "skills" / "swiftfairy" / "SKILL.md"
        if src_skill.exists():
            shutil.copy2(src_skill, cls.skill_dir / "SKILL.md")
            print(f"  ✅ Installed Skill: {cls.skill_dir / 'SKILL.md'}")

    @classmethod
    def uninstall(cls):
        # 1. Remove from config
        if cls.config_file.exists():
            try:
                lines = [l for l in cls.config_file.read_text(encoding="utf-8").splitlines() if not l.strip().startswith("//")]
                data = json.loads("\n".join(lines))
                if "swiftfairy" in data.get("mcp", {}):
                    del data["mcp"]["swiftfairy"]
                    cls.config_file.write_text(json.dumps(data, indent=2) + "\n", encoding="utf-8")
                    print(f"  🗑️  Removed swiftfairy from {cls.config_file}")
            except Exception as e:
                print(f"  ❌ Error modifying {cls.config_file}: {e}")
        # 2. Remove Skill
        if cls.skill_dir.exists():
            shutil.rmtree(cls.skill_dir)
            print(f"  🗑️  Removed skill: {cls.skill_dir}")

